{
  "name": "url-shortener-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/redirect",
    "packages/dashboard"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ui-source": "node scripts/check-ui-source.mjs",
