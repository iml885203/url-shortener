    "test:browser": "npm --prefix packages/dashboard/frontend run test:browser"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "miniflare": "^4.20260301.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "^0.35.5",
      "undici": "^7.30.2"
    }
  }
}
