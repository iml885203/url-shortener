name = "url-shortener-dashboard"
main = "src/index.ts"
compatibility_date = "2026-03-01"
compatibility_flags = ["nodejs_compat"]

routes = [
  { pattern = "your-domain.com/api/*", zone_name = "your-domain.com" },
  { pattern = "your-domain.com/dashboard/*", zone_name = "your-domain.com" },
  { pattern = "your-domain.com/auth/*", zone_name = "your-domain.com" },
]

[assets]
directory = "./frontend/dist"
binding = "ASSETS"

[[d1_databases]]
binding = "DB"
database_name = "url-shortener"
database_id = "your-d1-database-id"

[[kv_namespaces]]
binding = "KV"
id = "your-kv-namespace-id"

[[r2_buckets]]
binding = "R2"
bucket_name = "url-shortener-images"

[vars]
SHORT_BASE_URL = "https://your-domain.com"
R2_BASE_URL = "https://r2.your-domain.com"
DEFAULT_OG_IMAGE = "https://your-domain.com/dashboard/og-default.svg"

# Set secrets via: wrangler secret put API_KEY
